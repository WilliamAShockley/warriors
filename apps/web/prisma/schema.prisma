generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [vector]
}

model Target {
  id              String          @id @default(cuid())
  name            String
  company         String
  email           String?
  linkedin        String?
  websiteUrl      String?
  founderName     String?
  founderFirstName String?
  founderLastName  String?
  stage           String          @default("intro_sent")
  status          String          @default("yellow")
  lastContacted   DateTime?
  notes           String?
  aiNextStep      String?
  industry        String?
  starred         Boolean         @default(false)
  starRank        Int?
  draftEmailSubject     String?
  draftEmailBody        String?
  draftEmailGeneratedAt DateTime?

  // Hermes additions
  embedding       Unsupported("vector(1024)")?
  synthesizedBlob String?         // text blob for embedding
  score           Float?          // algorithmic relevance score
  sourceType      String?         // linkedin_company, vc_website, techcrunch, etc.
  sourceUrl       String?         // originating URL
  ingestedAt      DateTime?       // first ingestion timestamp
  onChainAddress  String?         // token contract or wallet
  clusterId       String?         // FK to Cluster

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  activities      Activity[]
  newsItems       NewsItem[]
  researchBrief   ResearchBrief?
  outreachBrief   OutreachBrief?
  founderReviews  FounderReview[]
  documents       Document[]
  persons         Person[]
  fundingRounds   FundingRound[]
  cluster         Cluster?        @relation(fields: [clusterId], references: [id])

  @@index([sourceType])
  @@index([clusterId])
  @@index([score])
  @@index([ingestedAt])
}

model Person {
  id            String   @id @default(cuid())
  name          String
  currentRole   String?
  currentCompany String?
  careerHistory String?  // JSON array of {employer, role, years}
  linkedinUrl   String?
  twitterHandle String?
  email         String?
  bio           String?
  embedding     Unsupported("vector(1024)")?
  synthesizedBlob String?
  score         Float?
  sourceType    String?  // linkedin_founder, linkedin_mutuals, twitter_follower, horizon_import
  sourceUrl     String?
  targetId      String?

  // ── Horizon OS firm-level graph additions ─────────────────────
  // Person is firm-scoped (shared across workspaces), not workspace-scoped.
  // Dedupe on email/linkedinUrl is enforced in the sourcing import code, not
  // by unique constraints — pre-existing Hermes rows may contain duplicates.
  firmId        String?
  emails        Json?    // additional emails beyond the primary `email`
  enrichment    Json?    // provenance-tagged enrichment blob: {source, fetchedAt, fields}
  tags          String[] @default([])
  status        String   @default("active") // active | do-not-contact | bounced
  deletedAt     DateTime? // soft delete — firm graph is never hard-deleted
  companyId     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  target        Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  firm          Firm?    @relation(fields: [firmId], references: [id])
  companyRef    Company? @relation(fields: [companyId], references: [id])
  interactions  Interaction[]
  memberships   CampaignMembership[]

  @@index([targetId])
  @@index([sourceType])
  @@index([firmId])
  @@index([status])
  @@index([email])
  @@index([linkedinUrl])
  @@index([tags], type: Gin)
}

model FundingRound {
  id            String   @id @default(cuid())
  targetId      String
  amount        String?  // e.g. "$25M"
  stage         String?  // seed, series_a, series_b, etc.
  date          DateTime?
  leadInvestor  String?
  coInvestors   String?  // JSON array of investor names
  sourceUrl     String?

  createdAt     DateTime @default(now())

  target        Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

model Cluster {
  id              String   @id @default(cuid())
  label           String
  description     String?
  embedding       Unsupported("vector(1024)")?
  memberCount     Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  targets         Target[]
}

model HermesRun {
  id          String    @id @default(cuid())
  block       String    // ingestion, enrichment, embedding, clustering, entity_resolution, scoring, search, outreach
  status      String    // running, passed, failed
  steps       String    // JSON array of step events
  durationMs  Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model FounderReview {
  id         String   @id @default(cuid())
  targetId   String
  candidates String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  target     Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model GmailToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiryDate   Float
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Activity {
  id             String   @id @default(cuid())
  targetId       String
  type           String
  description    String
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  gmailMessageId String?
  target         Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model NewsItem {
  id          String   @id @default(cuid())
  targetId    String
  headline    String
  url         String
  source      String
  summary     String   @default("")
  publishedAt DateTime
  createdAt   DateTime @default(now())
  target      Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String
  prompt      String
  section     String   @default("targets")
  model       String   @default("claude-opus-4-6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResearchBrief {
  id          String   @id @default(cuid())
  targetId    String   @unique
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  target      Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model Todo {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FocusTask {
  id          String    @id @default(cuid())
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    FocusTaskComment[]
}

model FocusTaskComment {
  id        String    @id @default(cuid())
  taskId    String
  text      String
  createdAt DateTime  @default(now())
  task      FocusTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Project {
  id        String           @id @default(cuid())
  name      String
  status    String           @default("idea")
  notes     String?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  subtasks  ProjectSubtask[]
  links     ProjectLink[]
}

model ProjectSubtask {
  id        String   @id @default(cuid())
  projectId String
  text      String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  url       String
  label     String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// People to recruit into Nazare, tracked through a hiring pipeline.
model Recruit {
  id        String        @id @default(cuid())
  name      String
  role      String? // role they'd fill at Nazare
  company   String? // where they are now
  email     String?
  linkedin  String?
  status    String        @default("prospect") // prospect | reached_out | in_conversation | interviewing | offer | joined | passed
  notes     String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  links     RecruitLink[]
}

model RecruitLink {
  id        String   @id @default(cuid())
  recruitId String
  url       String
  label     String?
  createdAt DateTime @default(now())
  recruit   Recruit  @relation(fields: [recruitId], references: [id], onDelete: Cascade)

  @@index([recruitId])
}

model ContentFolder {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  links     ContentLink[]
}

model ContentLink {
  id          String         @id @default(cuid())
  title       String
  url         String
  description String?
  tag         String?
  folderId    String?
  folder      ContentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model OutreachBrief {
  id           String   @id @default(cuid())
  targetId     String   @unique
  target       Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  summary      String
  founders     String
  fundingStage String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Morning Report ─────────────────────────────────────────────
// A daily snapshot of every open item across To-Do's, Need to Do,
// and Project subtasks — triaged and (where possible) pre-drafted.

model MorningReport {
  id        String       @id @default(cuid())
  date      DateTime     @default(now())
  status    String       @default("generating") // generating | ready | failed
  summary   String       @default("") // AI "here's your day" blurb
  itemCount Int          @default(0)
  error     String?
  createdAt DateTime     @default(now())
  items     ReportItem[]

  @@index([date])
}

model ReportItem {
  id            String        @id @default(cuid())
  reportId      String
  report        MorningReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sourceType    String // todo | focus_task | project_subtask
  sourceId      String
  sourceText    String // snapshot of the item text at report time
  sourceContext String? // e.g. parent project name
  category      String        @default("manual") // email_reply | calendar | follow_up | manual
  priority      Int           @default(0) // higher = more urgent
  reasoning     String? // why it was categorized/prioritized this way
  createdAt     DateTime      @default(now())
  draft         ActionDraft?

  @@index([reportId])
}

model ActionDraft {
  id           String     @id @default(cuid())
  reportItemId String     @unique
  reportItem   ReportItem @relation(fields: [reportItemId], references: [id], onDelete: Cascade)
  type         String // email | calendar | follow_up

  // email / follow_up fields
  emailTo       String?
  emailThreadId String?
  emailSubject  String?
  emailBody     String?

  // calendar fields
  eventTitle       String?
  eventStart       DateTime?
  eventEnd         DateTime?
  eventAttendees   String? // JSON array of emails
  eventLocation    String?
  eventDescription String?

  // lifecycle / autonomy gate
  status          String    @default("pending") // pending | approved | executed | dismissed | failed
  autoExecuted    Boolean   @default(false)
  executedAt      DateTime?
  executionResult String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonitorTheme {
  id            String       @id @default(cuid())
  name          String
  description   String
  keywords      String?
  enabled       Boolean      @default(true)
  lastScannedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  hits          MonitorHit[]
}

model MonitorHit {
  id           String        @id @default(cuid())
  themeId      String
  companyName  String
  url          String?
  description  String
  matchReason  String
  source       String
  sourceUrl    String?
  status       String        @default("pending")
  targetId     String?
  rawData      String?
  autoPromoted Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  theme        MonitorTheme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
}

model Agent {
  id              String     @id @default(cuid())
  name            String
  description     String     @default("")
  prompt          String
  triggerType     String     @default("manual")
  intervalSeconds Int?
  eventType       String?
  scope           String     @default("global")
  model           String     @default("claude-opus-4-6")
  enabled         Boolean    @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  runs            AgentRun[]
}

model AgentRun {
  id        String   @id @default(cuid())
  agentId   String
  targetId  String?
  status    String   @default("success")
  output    String   @default("")
  trigger   String   @default("manual")
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Document {
  id        String          @id @default(cuid())
  title     String
  type      String          // "note" | "file" | "indexed"
  content   String?         // markdown body for notes; extracted text for indexed
  mimeType  String?
  fileUrl   String?         // Vercel Blob URL
  fileSize  Int?            // bytes
  targetId  String?
  target    Target?         @relation(fields: [targetId], references: [id], onDelete: SetNull)
  chunks    DocumentChunk[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  ordinal    Int
  // Voyage AI embedding stored as libSQL F32_BLOB. Vector index is created
  // out-of-band by scripts/setup-vector-index.ts since Prisma can't model it.
  embedding  Bytes?
  createdAt  DateTime @default(now())

  @@index([documentId, ordinal])
}

// ═══════════════════════════════════════════════════════════════
// Horizon OS — firm scoping, outreach CRM layer, missions, chat
// ═══════════════════════════════════════════════════════════════

// Minimal firm/workspace scoping. Person + Interaction are firm-level
// (shared across every workspace of the firm); Campaign/Mission/ChatSession
// are workspace-scoped. Scope resolution lives in src/lib/horizon/scope.ts —
// all Horizon queries go through it. Existing single-operator auth is
// unchanged; a default Firm + Workspace row is created on first use.
model Firm {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  workspaces Workspace[]
  persons    Person[]
  interactions Interaction[]
}

model Workspace {
  id        String   @id @default(cuid())
  firmId    String
  name      String
  createdAt DateTime @default(now())
  firm      Firm     @relation(fields: [firmId], references: [id])
  campaigns Campaign[]
  missions  Mission[]
  chatSessions ChatSession[]

  @@index([firmId])
}

model Company {
  id         String   @id @default(cuid())
  firmId     String?
  name       String
  domain     String?
  stage      String?
  sector     String?
  enrichment Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  persons    Person[]

  @@index([domain])
}

// Append-only touch history on the firm graph. Never hard-deleted.
model Interaction {
  id             String    @id @default(cuid())
  firmId         String?
  personId       String
  channel        String    // email | linkedin | call | meeting | other
  direction      String    // outbound | inbound
  campaignId     String?
  body           String?
  summary        String?
  classification String?   // interested | not-now | referral | negative | other
  occurredAt     DateTime  @default(now())
  metadata       Json?
  createdAt      DateTime  @default(now())

  person   Person    @relation(fields: [personId], references: [id])
  firm     Firm?     @relation(fields: [firmId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([personId, occurredAt])
  @@index([campaignId])
  @@index([classification])
}

model Campaign {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  hypothesis      String?
  icpDefinition   Json?    // {criteria, exclusions: {recontactDays, excludeTags, ...}}
  messageStrategy String?
  sequence        Json?    // ordered touches: [{channel, delayDays, template}]
  status          String   @default("draft") // draft | sourcing | awaiting-list-approval | drafting | awaiting-strategy-approval | running | paused | completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  memberships  CampaignMembership[]
  interactions Interaction[]
  missions     Mission[]

  @@index([workspaceId])
  @@index([status])
}

model CampaignMembership {
  id                String    @id @default(cuid())
  campaignId        String
  personId          String
  state             String    @default("sourced") // sourced | enriched | drafted | approved | queued | sent | replied | closed | excluded
  outcome           String?   // interested | not-now | referral | negative | other
  currentTouchIndex Int       @default(0)
  nextActionAt      DateTime?
  drafts            Json?     // [{touchIndex, channel, subject?, body, approved, editedBody?, sentAt?, placement?}]

  // Placement sub-state for the CURRENT touch (LinkedIn or manual email).
  // Kept in columns (not the drafts JSON) so runner claiming can use an
  // atomic optimistic updateMany — two runners can never claim one touch.
  // Historical placement info is folded back into `drafts` when a touch
  // completes. Sub-states: queued -> claimed -> placed -> sent (or
  // placement-failed back to the manual queue).
  placementState String?
  claimedAt      DateTime?
  placedAt       DateTime?
  placementError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  person   Person   @relation(fields: [personId], references: [id])

  @@unique([campaignId, personId])
  @@index([state, nextActionAt])
  @@index([placementState])
}

model Mission {
  id          String   @id @default(cuid())
  workspaceId String
  type        String   // outreach_campaign (first mission type)
  title       String
  instruction String   // operator's original plain-language ask, verbatim
  campaignId  String?
  status      String   @default("created") // created | running | awaiting-approval | paused | completed | failed
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  campaign  Campaign? @relation(fields: [campaignId], references: [id])
  events    MissionEvent[]
  approvals Approval[]

  @@index([workspaceId])
  @@index([status])
}

// Append-only activity log.
model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  kind      String   // status-change | progress | approval-requested | approval-resolved | error | note
  payload   Json?
  actor     String   @default("system") // system | user | runner | agent
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id])

  @@index([missionId, createdAt])
}

// Human gates. The chat agent has NO tool that writes to this table —
// approvals are resolved only through the structured approval-queue UI.
// Send paths verify status=approved rows exist before any external send.
model Approval {
  id         String    @id @default(cuid())
  missionId  String
  kind       String    // target-list | message-strategy | draft-batch | release
  payload    Json?     // what exactly is being approved (person ids, draft sample, ...)
  status     String    @default("pending") // pending | approved | rejected
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  mission Mission @relation(fields: [missionId], references: [id])

  @@index([missionId])
  @@index([status])
}

model ChatSession {
  id          String   @id @default(cuid())
  workspaceId String
  title       String   @default("New session")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  messages  ChatMessage[]

  @@index([workspaceId, updatedAt])
}

// Content stored in Anthropic content-block shape so history replays
// directly into API calls. Append-only.
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // user | assistant
  content   Json     // array of content blocks: text | tool_use | tool_result
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}

// ── OG — drafting diagnostic bench ─────────────────────────────
// One row per test run: drop in a company name or URL, research it,
// generate a structured touch-1 draft, store the full JSON evidence
// (enrichment, parts, checks) for row-level diagnosis.
model OgRun {
  id          String   @id @default(cuid())
  mode        String   // 'name' | 'url' — which input tab produced the run
  input       String
  founderName String?
  company     String?
  enrichment  Json?    // research/enrichment payload shown to the model
  result      Json?    // { parts, checks, checksPassed, repaired, subject, body }
  error       String?
  createdAt   DateTime @default(now())

  @@index([mode, createdAt])
}
